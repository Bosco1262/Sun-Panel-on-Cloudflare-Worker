# Glob API URL
# 全局 API 地址
VITE_GLOB_API_URL=/api

# Local development: requests are proxied by Vite to the Cloudflare Worker (wrangler dev defaults to 8787)
# 本地开发: 由 Vite 代理转发到 Cloudflare Worker (wrangler dev 默认 8787)
VITE_APP_API_BASE_URL=http://127.0.0.1:8787/

# When you want to use PWA
# 需要启用 PWA 时打开
VITE_GLOB_APP_PWA=false

# Written automatically by add-frontend-version.js during the build
# 构建时由 add-frontend-version.js 自动写入
VITE_APP_VERSION=0
